# ============================================================================
# router.env.example - template for tars/gx10-router/router.env (2026-10-21).
# The LIVE router.env (with real keys) is gitignored; copy this to router.env
# and fill the values, or run deploy_key_factory.sh which wires them for you.
# ============================================================================

# Abliteration admin key (the ONLY admin key - org-owned, sk_...)
ABLITERATION_ADMIN_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The 2-key throughput pool (minted by abliteration_keys.py ensure-pool 2)
ABLIT_POOL_KEY_A=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABLIT_POOL_KEY_B=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hive secret (the GLM/DeepSeek helm hops)
HIVE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxx

# LiteLLM master key (what TARS clients send as their API key)
LITELLM_MASTER_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Remote captioner fallback (vision bridge; only if the local sensor is down)
# CAPTIONER_REMOTE_URL=https://api.abliteration.ai/v1/chat/completions
# CAPTIONER_REMOTE_MODEL=abliterated-model
# CAPTIONER_TIMEOUT=120

# ---------------------------------------------------------------------------
# EXTENDED 2026-10-21 — reconciliation with the actual consumers
# (litellm_config.yaml, vision_bridge.py, verify.sh, deploy_key_factory.sh,
# agent-tars.config.ts). The original block above is preserved verbatim;
# everything the box actually reads is below. Values here are REDACTED
# placeholders only — the live router.env is gitignored (see .gitignore:
# "tars/gx10-router/router.env").
# ---------------------------------------------------------------------------

# Abliteration per-client API key. REQUIRED by:
#   * vision_bridge.py REMOTE_CAPTIONER_KEY (the remote captioner credential)
#   * verify.sh (env-first key check; ROUTER_ENV_FILE fallback, never echoed)
#   * TARS clients (agent-tars.config.ts reads process.env.ABLITERATION_API_KEY)
# On the box it is set EQUAL to LITELLM_MASTER_KEY ("one secret everywhere").
ABLITERATION_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# LiteLLM + constellation chain bindings (litellm_config.yaml)
# ---------------------------------------------------------------------------
# master_key: os.environ/LITELLM_MASTER_KEY — already declared above.
# HIVE hops (GLM-5.3-flash / DeepSeek-V4.1-flash-1017 on api-cdn.thehive.ai):
HIVE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxx
# ABLIT V2L dual deployments (round-robin pool keys; deploy_key_factory.sh
# wires these from abliteration_keys.py ensure-pool 2): already declared above.
# ABLIT_POOL_KEY_A=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ABLIT_POOL_KEY_B=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Vision bridge knobs (vision_bridge.py — all optional, defaults shown)
# ---------------------------------------------------------------------------
# Master switch (VISION_BRIDGE=0 disables the bridge callback entirely):
VISION_BRIDGE=1
# Models whose image parts get rewritten to text captions:
BRIDGE_BRIDGED_MODELS=abliterated-model-large-v2,tars-hybrid
# BRIDGE_ALL_MODELS=0            # 1 = bridge every model
# BRIDGE_MAX_IMAGES=24           # images processed per request
# BRIDGE_LOG=1                   # [vision-bridge HH:MM:SS] journal lines
# Local sensor first (gx10 llm-hub :4000, no auth — keeps all Abliteration
# spend on V2 large):
# CAPTIONER_LOCAL_ENABLED=1
# CAPTIONER_LOCAL_URL=http://127.0.0.1:4000/v1/chat/completions
# CAPTIONER_LOCAL_MODEL=gemma3-27b-heretic-vl
# CAPTIONER_LOCAL_KEY=           # llm-hub: no auth
# Remote fallback (credential = ABLITERATION_API_KEY above):
# CAPTIONER_REMOTE_ENABLED=1
# CAPTIONER_MAX_TOKENS=900

# ---------------------------------------------------------------------------
# Key rotation (README.md "Key rotation"): after rotating the ak_ key in the
# Abliteration.ai console, update the live router.env, then
#   systemctl --user restart litellm-router
# and rotate the Windows TARS configs (provider-hub/tars/) too.
# Never commit real values: the live router.env is gitignored; this example
# file carries only the redacted placeholders above.
# ---------------------------------------------------------------------------
