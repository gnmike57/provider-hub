# ============================================================================
# router.env.example - template for tars/gx10-router/router.env (2026-10-21).
# The LIVE router.env (with real keys) is gitignored; copy this to router.env
# and fill the values, or run deploy_key_factory.sh which wires them for you.
# ============================================================================

# Abliteration admin key (the ONLY admin key - org-owned, sk_...)
ABLITERATION_ADMIN_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The 2-key throughput pool (minted by abliteration_keys.py ensure-pool 2)
ABLIT_POOL_KEY_A=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABLIT_POOL_KEY_B=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hive secret (the GLM/DeepSeek helm hops)
HIVE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxx

# LiteLLM master key (what TARS clients send as their API key)
LITELLM_MASTER_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Remote captioner fallback (vision bridge; only if the local sensor is down)
# CAPTIONER_REMOTE_URL=https://api.abliteration.ai/v1/chat/completions
# CAPTIONER_REMOTE_MODEL=abliterated-model
# CAPTIONER_TIMEOUT=120
