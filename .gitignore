# TARS workspace + node trees (npm install artifacts; never commit)
tars/node_modules/
tars/tars-workspace/
# the LIVE gx10 router env holds real keys - commit the .example instead
tars/gx10-router/router.env

# IDE state
.idea/

# tool caches (untracked; never commit)
.mypy_cache/
.ruff_cache/

# production runtime state - billing / audit / learned maps (never commit;
# verified live: billing.py USERS_PATH/USAGE_PATH, siphon.py SIPHON_AUDIT_FILE,
# camouflage._path(), skills_memory._path() all default to these at the root)
usage_events.jsonl
usage_events.jsonl.tmp
users.jsonl
card_amount_audit.jsonl
skills_memory.jsonl
camouflage_map.jsonl

# dated suite transcripts (.txt) stay tracked even if a broad results
# ignore lands later; must precede the sentinel-dump rule to keep it ignored
!evals/results/*.txt
# hub runtime artifacts under evals/results (pid / watchdog state / dumps)
evals/results/frost_hub.pid
evals/results/frost_watchdog_state.json
evals/results/_sentinel_dump*
evals/results/gw_receipts/

# 2026-10-22 hardening: runtime-CHURNING logs + probe scratch under
# evals/results dirty `git status` on every boot/probe run - they are
# machine state, not repo content. Untracked via `git rm --cached`; the
# dated suite transcripts + audit jsonl records stay tracked (the .txt
# re-include lives ABOVE, before the sentinel-dump rule).
evals/results/*.log
evals/results/*.err
evals/results/*.out
evals/results/boot_audit.jsonl
evals/results/_commit.txt
evals/results/_baseline_*

# ---------------------------------------------------------------------------
