# NanoGPT API key. Copy to `.env` or export in your shell.
# NEVER commit the real key and NEVER put it in an Agent Card.
NANOGPT_API_KEY=YOUR_NANOGPT_API_KEY

# Optional MCP server config (defaults shown in agent-tooling.md)
# NANOGPT_BASE_URL=https://nano-gpt.com
# NANOGPT_AUTH_MODE=bearer
# NANOGPT_LOG_LEVEL=info
# NANOGPT_TIMEOUT_MS=120000
# NANOGPT_MAX_RETRIES=0
# NANOGPT_DEFAULT_MODEL=claw-medium